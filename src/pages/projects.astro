---
import Layout from '@/layouts/Layout.astro'
import { getCollection } from 'astro:content'

const projects = (await getCollection('projects')).sort(
  (a, b) =>
    Number(b.data.featured ?? false) - Number(a.data.featured ?? false) ||
    b.data.date.getTime() - a.data.date.getTime()
)
---

<Layout title="Projects · Sam Jin">
  <h1 class="text-2xl font-semibold mb-10">Projects</h1>
  <div class="space-y-8">
    {
      projects.map(project => (
        <div>
          <div class="flex items-baseline justify-between gap-4">
            <a
              href={`/projects/${project.id}`}
              class="text-sm font-medium text-accent hover:underline underline-offset-4"
            >
              {project.data.title}
            </a>
            <span class="text-xs font-mono text-faint whitespace-nowrap">
              {project.data.date.getFullYear()}
            </span>
          </div>
          <p class="mt-1.5 text-sm text-muted-foreground">
            {project.data.excerpt}
          </p>
          {project.data.tags.length > 0 && (
            <p class="mt-1.5 text-xs font-mono text-faint">
              {project.data.tags.join(' · ')}
            </p>
          )}
        </div>
      ))
    }
  </div>
</Layout>
