---
import Layout from '@/layouts/Layout.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import TrainingCurve from '@/components/TrainingCurve.astro'
import { getCollection } from 'astro:content'
import { personalInfo, timeline, education, sideProjects } from '@/lib/data'

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)

const postDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })

const selected = [
  { title: 'Lynx code-generation benchmark', href: '/projects', meta: 'now' },
  ...sideProjects
    .filter(p => ['e2e on Lynx', 'Second Look'].includes(p.title))
    .map(p => ({ title: p.title, href: p.href!, meta: p.meta.slice(0, 4) }))
]

const external = (href: string) => !href.startsWith('/')
const link = 'text-accent hover:underline underline-offset-4'
---

<Layout wide>
  <section>
    <div>
      <h1 class="font-serif font-medium text-4xl sm:text-[2.75rem] leading-[1.1] tracking-tight">
        {personalInfo.name}
      </h1>
      <p class="mt-4 max-w-[34em] text-lg leading-relaxed">
        AI engineer at <b class="font-semibold">ByteDance</b>. I build the
        benchmark, the coding agent, and the RL training that help language
        models write code for{' '}<a
          href="https://lynxjs.org/"
          target="_blank"
          rel="noopener noreferrer"
          class={link}>Lynx</a
        >.
      </p>
      <p class="mt-4 text-[0.8125rem] font-mono text-faint">
        {personalInfo.location.replace(', California', '')}{' · '}<a
          href={personalInfo.github}
          target="_blank"
          rel="noopener noreferrer"
          class={link}>GitHub</a
        >{' · '}<a
          href={personalInfo.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class={link}>LinkedIn</a
        >{' · '}<a href={`mailto:${personalInfo.email}`} class={link}>Email</a>
      </p>
    </div>
  </section>

  <section class="mt-16">
    <SectionHeading title="Experience" />
    <div class="mt-5 grid items-start gap-x-11 gap-y-8 md:grid-cols-[1fr_0.95fr]">
      <ul id="jobs">
          {
            timeline.map((job, i) => (
              <li
                data-job={job.key}
                class:list={[
                  'job -mx-2.5 grid grid-cols-[5.6rem_minmax(0,1fr)] gap-x-2.5 rounded-md px-2.5 py-2.5 transition-colors',
                  i === 0 && 'on'
                ]}
              >
                <span class="font-mono text-[0.78rem] leading-6 text-faint">
                  {job.years}
                </span>
                <div>
                  <p class="leading-6 text-[0.9375rem]">
                    <b class="font-semibold">{job.title}</b>
                    <span class="text-muted-foreground"> · {job.place}</span>
                  </p>
                  <p class="mt-0.5 text-sm leading-relaxed text-muted-foreground">
                    {job.line}
                  </p>
                </div>
              </li>
            ))
          }
      </ul>
      <div>
      <figure>
        <TrainingCurve checkpoints={timeline} />
        <figcaption class="mt-2 text-[0.8125rem] leading-relaxed text-muted-foreground">
          The same years drawn as a training curve. Lower means I was surer of
          what to work on. The bump in 2023 is quitting my job to go back to
          school.
        </figcaption>
      </figure>
        <h3 class="mt-8 font-mono text-[0.6875rem] font-medium uppercase tracking-widest text-faint">Education</h3>
        <ul class="mt-2.5 space-y-1.5 text-sm">
          {
            education.map(school => (
              <li class="grid grid-cols-[5.6rem_minmax(0,1fr)] gap-x-2.5">
                <span class="font-mono text-[0.78rem] leading-6 text-faint">
                  {school.period.replace(/ - \d\d/, ' – ')}
                </span>
                <span class="leading-6">
                  {school.degree}
                  <span class="text-muted-foreground">
                    {' '}
                    · {school.institution}
                  </span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="mt-16 grid gap-x-11 gap-y-10 md:grid-cols-2">
    <div>
      <h2 class="text-[1.0625rem] font-semibold">Selected projects</h2>
      <ul class="mt-3">
        {
          selected.map(item => (
            <li class="flex items-baseline justify-between gap-4 border-t py-2">
              <a
                href={item.href}
                target={external(item.href) ? '_blank' : undefined}
                rel={external(item.href) ? 'noopener noreferrer' : undefined}
                class="text-[0.9375rem] hover:text-accent transition-colors"
              >
                {item.title}
              </a>
              <span class="font-mono text-xs text-faint whitespace-nowrap">
                {item.meta}
              </span>
            </li>
          ))
        }
      </ul>
      <a href="/projects" class={`mt-3 inline-block text-sm ${link}`}>
        All projects →
      </a>
    </div>
    <div>
      <h2 class="text-[1.0625rem] font-semibold">Recent writing</h2>
      <ul class="mt-3">
        {
          posts.map(post => (
            <li class="flex items-baseline justify-between gap-4 border-t py-2">
              <a
                href={`/blog/${post.id}`}
                data-vt={`/blog/${post.id}`}
                class="text-[0.9375rem] hover:text-accent transition-colors"
              >
                {post.data.title}
              </a>
              <span class="font-mono text-xs text-faint whitespace-nowrap">
                {postDate(post.data.date)}
              </span>
            </li>
          ))
        }
      </ul>
      <a href="/blog" class={`mt-3 inline-block text-sm ${link}`}>
        All writing →
      </a>
    </div>
  </section>
</Layout>

<style>
  .job.on {
    background-color: var(--muted);
  }
</style>

<script>
  // Hovering a job highlights its checkpoint on the curve, and the other way
  const linked = document.querySelectorAll<HTMLElement | SVGElement>(
    '#jobs [data-job], .curve [data-job]'
  )
  const highlight = (key: string | undefined) =>
    linked.forEach(el => el.classList.toggle('on', el.dataset.job === key))

  linked.forEach(el => {
    el.addEventListener('mouseenter', () => highlight(el.dataset.job))
    el.addEventListener('click', () => highlight(el.dataset.job))
  })
  highlight(document.querySelector<HTMLElement>('#jobs [data-job]')?.dataset.job)
</script>
