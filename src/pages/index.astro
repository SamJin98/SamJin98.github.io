---
import Layout from '@/layouts/Layout.astro'
import TrainingCurve from '@/components/TrainingCurve.astro'
import { getCollection } from 'astro:content'
import { personalInfo, timeline, sideProjects } from '@/lib/data'

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)

const postDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })

const selected = [
  { title: 'Lynx code-generation benchmark', href: '/projects', meta: 'now' },
  ...sideProjects
    .filter(p => ['e2e on Lynx', 'Second Look'].includes(p.title))
    .map(p => ({ title: p.title, href: p.href!, meta: p.meta.slice(0, 4) }))
]

const external = (href: string) => !href.startsWith('/')

// The descent path: where I studied and worked, oldest first, walking down
// the right-hand hill of the painting into the valley. `x` is the position
// across the picture (0 to 1); the height follows that hill's ridge, as
// painted by scripts/paint-landscape.cjs.
const ridge = (x: number) =>
  0.29 +
  0.19 * Math.exp(-((x - 0.82) ** 2) / (2 * 0.13 ** 2)) +
  0.05 * Math.exp(-((x - 0.2) ** 2) / (2 * 0.14 ** 2))

const stops = [
  {
    key: 'rpi',
    label: 'RPI',
    years: '2016 – 21',
    title: 'BS in IT and Web Science',
    place: 'Rensselaer Polytechnic Institute',
    line: 'Minor in Philosophy.'
  },
  ...[...timeline].reverse()
].map((stop, i, all) => {
  const x = 0.92 - (i / (all.length - 1)) * 0.44
  return {
    ...stop,
    left: `${(x * 100).toFixed(2)}%`,
    top: `${((1 - ridge(x) - 0.022) * 100).toFixed(2)}%`,
    // Neighbouring tags sit at two heights so they don't collide
    high: i % 2 === 1,
    now: i === all.length - 1
  }
})

const link = 'text-accent hover:underline underline-offset-4'
---

<Layout scene>
  <div class="top">
  <section class="pt-4 lg:pt-2">
    <h1
      class="font-serif font-medium text-5xl leading-[1.05] tracking-tight sm:text-6xl"
    >
      {personalInfo.name}
    </h1>
    <p class="strip mt-5 max-w-[30em] text-[1.0625rem] leading-relaxed sm:text-lg">
      AI engineer at <b class="font-semibold">ByteDance</b>. I build the
      benchmark, the coding agent, and the RL training that help language
      models write code for{' '}<a
        href="https://lynxjs.org/"
        target="_blank"
        rel="noopener noreferrer"
        class={link}>Lynx</a
      >.
    </p>
    <p class="strip mt-2.5 text-[0.8125rem] font-mono text-muted-foreground">
      {personalInfo.location.replace(', California', '')}{' · '}<a
        href={personalInfo.github}
        target="_blank"
        rel="noopener noreferrer"
        class={link}>GitHub</a
      >{' · '}<a
        href={personalInfo.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class={link}>LinkedIn</a
      >{' · '}<a href={`mailto:${personalInfo.email}`} class={link}>Email</a>
    </p>
  </section>

  <figure class="fig">
    <TrainingCurve checkpoints={timeline} />
    <figcaption class="font-mono text-[0.6875rem]">
      Fig. 1 · the path below as a training curve
    </figcaption>
  </figure>
  </div>

  <div class="lists">
    <section>
      <h2 class="strip head">Selected projects</h2>
      <ul>
        {
          selected.map(item => (
            <li class="strip">
              <a
                href={item.href}
                class="hover:text-accent"
                {...(external(item.href)
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
              >
                {item.title}
              </a>
              <span class="meta">{item.meta}</span>
            </li>
          ))
        }
        <li class="strip"><a href="/projects" class={link}>All projects</a></li>
      </ul>
    </section>
    <section>
      <h2 class="strip head">Recent writing</h2>
      <ul>
        {
          posts.map(post => (
            <li class="strip">
              <a href={`/blog/${post.id}`} class="hover:text-accent">
                {post.data.title}
              </a>
              <span class="meta">{postDate(post.data.date)}</span>
            </li>
          ))
        }
        <li class="strip"><a href="/blog" class={link}>All writing</a></li>
      </ul>
    </section>
  </div>

  <ol class="path" aria-label="Where I studied and worked, oldest first">
    {
      stops.map(stop => (
        <li
          class:list={['stop', stop.high && 'high', stop.now && 'now']}
          style={`left:${stop.left};top:${stop.top}`}
          tabindex="0"
          data-job={stop.key}
        >
          <span class="dot" aria-hidden="true" />
          <div class="tag strip">
            <p class="whitespace-nowrap text-[0.8125rem] leading-5">
              <b class="font-semibold">{stop.label}</b>
              <span class="ml-1.5 font-mono text-[0.6875rem] text-muted-foreground">
                {stop.years}
              </span>
            </p>
            <div class="more">
              <p class="mt-1 text-[0.8125rem] leading-snug">
                {stop.title}
                <span class="text-muted-foreground"> · {stop.place}</span>
              </p>
              <p class="mt-1 text-[0.8125rem] leading-snug text-muted-foreground">
                {stop.line}
              </p>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</Layout>

<script>
  // Hovering a stop on the hill or a point on the curve highlights both
  const linked = document.querySelectorAll<HTMLElement>('[data-job]')
  const show = (key: string) =>
    linked.forEach(el => el.classList.toggle('on', el.dataset.job === key))
  linked.forEach(el => {
    const key = el.dataset.job!
    el.addEventListener('pointerenter', () => show(key))
    el.addEventListener('focusin', () => show(key))
  })
  show('bytedance')
</script>

<style>
  /* The figure is drawn straight on the sky, so it borrows the ink colour */
  .fig {
    --curve-axis: color-mix(in oklab, var(--foreground) 55%, transparent);
    --curve-text: color-mix(in oklab, var(--foreground) 80%, transparent);
    --curve-raw: var(--foreground);
    --curve-raw-opacity: 0.45;
    position: relative;
    max-width: 27rem;
    margin-top: 1.5rem;
  }

  .fig figcaption {
    position: absolute;
    top: 0;
    right: 0;
    color: var(--curve-text);
  }

  .lists a {
    display: inline-block;
    max-width: 15rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    vertical-align: bottom;
  }

  .lists {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.5rem;
    margin-top: 1.75rem;
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .lists ul {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-top: 0.3rem;
  }

  .lists .strip {
    padding: 0.2rem 0.55rem;
  }

  .lists .head {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .lists .meta {
    margin-left: 0.5rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.6875rem;
    color: var(--muted-foreground);
  }

  @media (min-width: 64rem) {
    .top {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 27rem;
      gap: 3rem;
      align-items: start;
    }

    .fig {
      margin-top: 0;
    }

    .lists {
      position: relative;
      z-index: 2;
      flex-wrap: nowrap;
      gap: 1.5rem;
      width: fit-content;
      margin-top: 0.75rem;
    }
  }

  /* Small screens: the stops are a plain column of strips under the intro */
  .path {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 1.5rem;
    padding-bottom: calc(var(--paint-width) * 0.13);
  }

  .dot {
    display: none;
  }

  .more {
    display: none;
  }

  .stop:hover .more,
  .stop:focus .more,
  .stop:focus-within .more {
    display: block;
    width: 15rem;
  }

  .stop:focus {
    outline: none;
  }

  /* Wide screens: the stops sit on the painted hill. The list is laid over
     the ground picture at the same size, so left/top are positions in it. */
  @media (min-width: 48rem) {
    .path {
      display: block;
      position: absolute;
      left: 50%;
      bottom: 0;
      width: var(--paint-width);
      aspect-ratio: 1800 / 800;
      margin: 0;
      padding: 0;
      transform: translateX(-50%);
      pointer-events: none;
      z-index: 1;
    }

    .stop {
      position: absolute;
      pointer-events: auto;
    }

    .dot {
      display: block;
      position: absolute;
      left: -0.3rem;
      top: -0.3rem;
      width: 0.6rem;
      height: 0.6rem;
      border-radius: 50%;
      background-color: var(--foreground);
      box-shadow: 0 0 0 2px var(--background);
    }

    .now .dot {
      left: -0.45rem;
      top: -0.45rem;
      width: 0.9rem;
      height: 0.9rem;
      background-color: var(--accent);
    }

    .tag {
      position: absolute;
      left: 0;
      bottom: 1rem;
      transform: translateX(-50%);
      box-shadow: 0 1px 3px oklch(0 0 0 / 22%);
    }

    .high .tag {
      bottom: 3.4rem;
    }

    /* A thin stem from the higher tags down to their dot */
    .high::before {
      content: '';
      position: absolute;
      left: -0.5px;
      bottom: 0.4rem;
      width: 1px;
      height: 3rem;
      background-color: var(--foreground);
      opacity: 0.55;
    }

    .stop.on .dot {
      box-shadow:
        0 0 0 2px var(--background),
        0 0 0 4px var(--accent);
    }

    .stop:hover,
    .stop:focus,
    .stop:focus-within {
      z-index: 1;
    }
  }
</style>
