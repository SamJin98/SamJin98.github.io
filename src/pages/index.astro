---
import Layout from '@/layouts/Layout.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import TrainingCurve from '@/components/TrainingCurve.astro'
import { getCollection } from 'astro:content'
import { personalInfo, timeline, education, sideProjects } from '@/lib/data'

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)

const postDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })

const selected = [
  { title: 'Lynx code-generation benchmark', href: '/projects', meta: 'now' },
  ...sideProjects
    .filter(p => ['e2e on Lynx', 'Second Look'].includes(p.title))
    .map(p => ({ title: p.title, href: p.href!, meta: p.meta.slice(0, 4) }))
]

const external = (href: string) => !href.startsWith('/')
const link = 'text-accent hover:underline underline-offset-4'
---

<Layout wide home>
  <section>
    <h1 class="font-serif font-medium text-4xl sm:text-[2.75rem] leading-[1.1] tracking-tight">
      {personalInfo.name}
    </h1>
    <p class="mt-4 max-w-[36em] text-lg leading-relaxed">
      AI engineer at <b class="font-semibold">ByteDance</b>. I build the
      benchmark, the coding agent, and the RL training that help language
      models write code for{' '}<a
        href="https://lynxjs.org/"
        target="_blank"
        rel="noopener noreferrer"
        class={link}>Lynx</a
      >.
    </p>
    <p class="mt-3 text-[0.8125rem] font-mono text-faint">
      {personalInfo.location.replace(', California', '')}{' · '}<a
        href={personalInfo.github}
        target="_blank"
        rel="noopener noreferrer"
        class={link}>GitHub</a
      >{' · '}<a
        href={personalInfo.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class={link}>LinkedIn</a
      >{' · '}<a href={`mailto:${personalInfo.email}`} class={link}>Email</a>
    </p>
  </section>

  <div class="mt-9 grid items-start gap-x-10 gap-y-9 lg:grid-cols-[1.25fr_1fr_1fr]">
    <section>
      <SectionHeading title="Experience" />
      <ul id="jobs" class="mt-2">
        {
          timeline.map((job, i) => (
            <li
              data-job={job.key}
              class:list={[
                'job -mx-2 grid grid-cols-[4.6rem_minmax(0,1fr)] gap-x-2 rounded-md px-2 py-1.5 transition-colors',
                i === 0 && 'on'
              ]}
            >
              <span class="font-mono text-[0.72rem] leading-[1.375rem] text-faint">
                {job.years}
              </span>
              <div>
                <p class="text-sm leading-[1.375rem]">
                  <b class="font-semibold">{job.title}</b>
                  <span class="text-muted-foreground"> · {job.place}</span>
                </p>
                <p class="desc mt-0.5 text-[0.8125rem] leading-snug text-muted-foreground">
                  {job.line}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <SectionHeading title="Training curve" />
      <figure class="mt-3">
        <TrainingCurve checkpoints={timeline} />
        <figcaption class="mt-1 text-xs leading-snug text-muted-foreground">
          The same years as a loss curve. The bump in 2023 is quitting my job
          to go back to school.
        </figcaption>
      </figure>
      <h3 class="mt-4 font-mono text-[0.6875rem] font-medium uppercase tracking-widest text-faint">
        Education
      </h3>
      <ul class="mt-1.5 space-y-1 text-[0.8125rem] leading-snug">
        {
          education.map(school => (
            <li>
              {school.degree}
              <span class="text-muted-foreground">
                {' · '}
                {school.institution}
              </span>
              <span class="ml-1 whitespace-nowrap font-mono text-[0.6875rem] text-faint">
                {school.period.replace(/ - \d\d/, ' – ')}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="grid gap-y-6 sm:grid-cols-2 sm:gap-x-10 lg:grid-cols-1">
      <section>
        <SectionHeading title="Selected projects" />
        <ul>
          {
            selected.map(item => (
              <li class="flex items-baseline justify-between gap-3 border-b py-1.5">
                <a
                  href={item.href}
                  target={external(item.href) ? '_blank' : undefined}
                  rel={external(item.href) ? 'noopener noreferrer' : undefined}
                  class="text-sm hover:text-accent transition-colors"
                >
                  {item.title}
                </a>
                <span class="font-mono text-[0.6875rem] text-faint whitespace-nowrap">
                  {item.meta}
                </span>
              </li>
            ))
          }
        </ul>
        <a href="/projects" class={`mt-2 inline-block text-[0.8125rem] ${link}`}>
          All projects →
        </a>
      </section>
      <section>
        <SectionHeading title="Recent writing" />
        <ul>
          {
            posts.map(post => (
              <li class="flex items-baseline justify-between gap-3 border-b py-1.5">
                <a
                  href={`/blog/${post.id}`}
                  data-vt={`/blog/${post.id}`}
                  class="post text-sm hover:text-accent transition-colors"
                >
                  {post.data.title}
                </a>
                <span class="font-mono text-[0.6875rem] text-faint whitespace-nowrap">
                  {postDate(post.data.date)}
                </span>
              </li>
            ))
          }
        </ul>
        <a href="/blog" class={`mt-2 inline-block text-[0.8125rem] ${link}`}>
          All writing →
        </a>
      </section>
    </div>
  </div>
</Layout>

<style>
  .job.on {
    background-color: var(--muted);
  }

  /* On wide screens only the highlighted job shows its line, so the page
     fits one screen; long post titles stay on one line */
  @media (min-width: 64rem) {
    .job:not(.on) .desc {
      display: none;
    }

    .post {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
</style>

<script>
  // Hovering a job highlights its checkpoint on the curve, and the other way
  const linked = document.querySelectorAll<HTMLElement | SVGElement>(
    '#jobs [data-job], .curve [data-job]'
  )
  const highlight = (key: string | undefined) =>
    linked.forEach(el => el.classList.toggle('on', el.dataset.job === key))

  linked.forEach(el => {
    el.addEventListener('mouseenter', () => highlight(el.dataset.job))
    el.addEventListener('click', () => highlight(el.dataset.job))
  })
  highlight(document.querySelector<HTMLElement>('#jobs [data-job]')?.dataset.job)
</script>
