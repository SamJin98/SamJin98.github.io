---
import { getCollection, render } from 'astro:content'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import type { ImageMetadata } from 'astro'
import Layout from '@/layouts/Layout.astro'

interface Props {
  project: CollectionEntry<'projects'>
}

export async function getStaticPaths() {
  const projects = await getCollection('projects')
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project }
  }))
}

const { project } = Astro.props
const { Content } = await render(project)

const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/projects/resources/**/*.{png,jpg,jpeg,gif}'
)
const imagePath = `/src/content/projects/resources/${project.data.image}`
---

<Layout
  title={`${project.data.title} · Sam Jin`}
  description={project.data.excerpt}
>
  <a
    href="/projects"
    class="text-sm text-muted-foreground hover:text-foreground transition-colors"
  >
    ← All projects
  </a>

  <article class="mt-8">
    <header>
      <h1 class="text-2xl font-semibold leading-snug">{project.data.title}</h1>
      <p class="mt-3 text-sm font-mono text-faint">
        {project.data.date.getFullYear()}
        {
          project.data.tags.length > 0 && (
            <span> · {[...project.data.tags].sort().join(' · ')}</span>
          )
        }
        <span> · </span>
        <a
          href={project.data.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent hover:underline underline-offset-4">GitHub ↗</a
        >
        {
          project.data.demoUrl && (
            <span>
              {' '}
              ·{' '}
              <a
                href={project.data.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent hover:underline underline-offset-4"
              >
                Demo ↗
              </a>
            </span>
          )
        }
      </p>
      {
        project.data.excerpt && (
          <p class="mt-6 text-muted-foreground leading-relaxed border-l-2 pl-4">
            {project.data.excerpt}
          </p>
        )
      }
    </header>

    {
      imageFiles[imagePath] && (
        <Image
          src={imageFiles[imagePath]()}
          alt={project.data.title}
          width={1344}
          class="mt-8 rounded-md border"
        />
      )
    }

    <div class="prose mt-10">
      <Content />
    </div>
  </article>
</Layout>
