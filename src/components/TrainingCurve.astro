---
// The experience list drawn as a training curve: a noisy raw line, a smooth line
// on top, and a dot per job. Only the highlighted job shows its name. Rendered at build time;
// the script on the home page only links hover between the list and the dots.
interface Checkpoint {
  key: string
  label: string
  at: number
}

interface Props {
  checkpoints: Checkpoint[]
}

const { checkpoints } = Astro.props

const W = 520
const H = 300
const START = 2018
const SPAN = 9
const x = (year: number) => 34 + ((year - START) / SPAN) * 470
const y = (loss: number) => 30 + (1 - (loss - 0.1) / 0.8) * 205

// Hand-placed shape: steady descent, with a bump in 2023
const control: [number, number][] = [
  [2018, 0.8],
  [2019, 0.72],
  [2020, 0.65],
  [2021, 0.58],
  [2022, 0.5],
  [2023.4, 0.46],
  [2023.7, 0.64],
  [2024.1, 0.55],
  [2024.8, 0.42],
  [2025.4, 0.33],
  [2026.2, 0.25],
  [2026.9, 0.2]
]

const lossAt = (year: number) => {
  for (let i = 1; i < control.length; i++) {
    if (year <= control[i][0]) {
      const [a, la] = control[i - 1]
      const [b, lb] = control[i]
      const t = (year - a) / (b - a)
      return la + (lb - la) * t * t * (3 - 2 * t)
    }
  }
  return control[control.length - 1][1]
}

// Seeded noise so every build draws the same line
let seed = 11
const random = () => {
  seed = (seed + 0x6d2b79f5) | 0
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed)
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296
}

let raw = ''
let smooth = ''
const STEPS = 240
for (let i = 0; i <= STEPS; i++) {
  const year = START + (i / STEPS) * 8.9
  const loss = lossAt(year)
  const noise = (random() - 0.5) * (0.04 + loss * 0.09)
  raw += `${i ? 'L' : 'M'}${x(year).toFixed(1)} ${y(loss + noise).toFixed(1)}`
  if (i % 3 === 0)
    smooth += `${smooth ? 'L' : 'M'}${x(year).toFixed(1)} ${y(loss).toFixed(1)}`
}

const ticks = [2018, 2020, 2022, 2024, 2026]

const dots = checkpoints.map((c, i) => {
  const cx = x(c.at)
  const cy = y(lossAt(c.at))
  // Alternate label heights so neighbours don't collide
  const up = i % 2 === 0 ? 26 : 44
  return { ...c, cx, cy, up, tx: Math.max(cx, 54) }
})
---

<svg
  class="curve block w-full h-auto"
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-label="The experience list drawn as a line that falls from 2018 to 2026, with a bump in 2023"
>
  <path class="axis" d="M34 18V252H504"></path>
  {
    ticks.map(year => (
      <text
        class="small"
        x={x(year)}
        y="272"
        text-anchor={year === START ? 'start' : 'middle'}
      >
        {year}
      </text>
    ))
  }
  <path class="raw" d={raw}></path>
  <path class="smooth" d={smooth} pathLength="1"></path>
  {
    dots.map(d => (
      <g class="ck" data-job={d.key}>
        <path class="stem" d={`M${d.cx} ${d.cy - 8}V${d.cy - d.up + 5}`} />
        <text x={d.tx} y={d.cy - d.up} text-anchor="middle">
          {d.label}
        </text>
        <circle class="dot" cx={d.cx} cy={d.cy} r="5" />
        <circle class="hit" cx={d.cx} cy={d.cy - 12} r="24" />
      </g>
    ))
  }
</svg>

<style>
  .axis {
    fill: none;
    stroke: var(--border);
  }
  .small {
    font:
      11px ui-monospace,
      'SF Mono',
      Menlo,
      Consolas,
      monospace;
    fill: var(--faint-foreground);
  }
  .raw {
    fill: none;
    stroke: var(--faint-foreground);
    stroke-width: 1;
    opacity: 0.4;
  }
  .smooth {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    animation: draw 1.4s cubic-bezier(0.4, 0, 0.2, 1) both;
  }
  .ck {
    cursor: default;
  }
  .ck text {
    font:
      500 12px Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
    fill: var(--muted-foreground);
  }
  .stem {
    stroke: var(--border);
  }
  /* Only the highlighted job is named, so the line stays clean */
  .ck text,
  .stem {
    opacity: 0;
    transition: opacity 0.15s;
  }
  .ck.on text,
  .ck.on .stem {
    opacity: 1;
  }
  .dot {
    fill: var(--background);
    stroke: var(--accent);
    stroke-width: 2;
  }
  .hit {
    fill: transparent;
  }
  .ck.on .dot {
    fill: var(--accent);
  }
  .ck.on text {
    fill: var(--foreground);
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .smooth {
      animation: none;
    }
  }
</style>
