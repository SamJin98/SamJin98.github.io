---
// A painted field at the foot of every page. The blades sway in a slow wind
// and lean away from the pointer. Drawn on a canvas; with reduced motion it
// is painted once and left still.
---

<div class="meadow" aria-hidden="true">
  <canvas></canvas>
</div>

<style>
  .meadow {
    height: 8.5rem;
    margin-top: -1.5rem;
    /* Lets the tallest blades fade instead of ending in a hard edge */
    mask-image: linear-gradient(to bottom, transparent, #000 35%);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  interface Blade {
    x: number
    height: number
    width: number
    lean: number
    phase: number
    colour: string
    highlight: string
    head: boolean
    // spring state for the push from the pointer
    push: number
    speed: number
  }

  const palettes = {
    light: ['#b98a5a', '#cdb184', '#a9783f', '#d9c79f', '#96623a', '#a39a63'],
    dark: ['#63482c', '#8a6238', '#4a3823', '#a5773f', '#74552f', '#5f5a36']
  }

  const canvas = document.querySelector<HTMLCanvasElement>('.meadow canvas')
  const ctx = canvas?.getContext('2d')

  if (canvas && ctx) {
    const root = document.documentElement
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches
    let blades: Blade[] = []
    let ground: CanvasGradient | string = 'transparent'
    let width = 0
    let height = 0
    let pointerX = -1e4
    let pointerY = -1e4
    let visible = false
    let frame = 0

    // Seeded, so the field looks the same on every page and visit
    let seed = 7
    const random = () => {
      seed = (seed + 0x6d2b79f5) | 0
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed)
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296
    }

    const shade = (hex: string, by: number) => {
      const n = parseInt(hex.slice(1), 16)
      const part = (shift: number) =>
        Math.max(0, Math.min(255, Math.round(((n >> shift) & 255) * by)))
      return `rgb(${part(16)},${part(8)},${part(0)})`
    }

    const plant = () => {
      const palette = palettes[root.classList.contains('dark') ? 'dark' : 'light']
      const wash = ctx.createLinearGradient(0, height * 0.45, 0, height)
      wash.addColorStop(0, 'transparent')
      wash.addColorStop(1, palette[0] + '73')
      ground = wash
      seed = 7
      blades = []
      for (let x = -10; x < width + 10; x += 2.2 + random() * 2.6) {
        // Clumps: slow waves in height, so the top edge rolls like a field
        const clump =
          0.55 +
          0.25 * Math.sin(x / 90 + 1.3) +
          0.2 * Math.sin(x / 37 + 4.1)
        const colour = palette[Math.floor(random() * palette.length)]
        const tone = 0.88 + random() * 0.24
        blades.push({
          x,
          height: height * (0.28 + clump * 0.5 * (0.6 + random() * 0.6)),
          width: 1.6 + random() * 3.2,
          lean: (random() - 0.5) * 16,
          phase: random() * Math.PI * 2,
          colour: shade(colour, tone),
          highlight: shade(colour, tone * 1.16),
          head: random() < 0.14,
          push: 0,
          speed: 0
        })
      }
      // Shorter blades are painted last, in front
      blades.sort((a, b) => b.height - a.height)
    }

    const resize = () => {
      const box = canvas.getBoundingClientRect()
      const ratio = Math.min(devicePixelRatio || 1, 2)
      width = box.width
      height = box.height
      canvas.width = Math.round(width * ratio)
      canvas.height = Math.round(height * ratio)
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0)
      plant()
      paint(performance.now())
    }

    const paint = (now: number) => {
      const t = now / 1000
      ctx.clearRect(0, 0, width, height)
      // Underpainting: a soft wash of ground colour behind the roots
      ctx.fillStyle = ground
      ctx.fillRect(0, height * 0.45, width, height * 0.55)
      for (const blade of blades) {
        // Wind: one slow wave across the field plus each blade's own flutter
        const wind =
          Math.sin(t * 0.7 + blade.x * 0.012) * 7 +
          Math.sin(t * 1.9 + blade.phase) * 2.2

        // The pointer pushes nearby blades aside; a spring brings them back
        const tipY = height - blade.height
        const dx = blade.x - pointerX
        const dy = Math.max(0, tipY - pointerY)
        const distance = Math.hypot(dx, dy * 0.6)
        const reach = 110
        const target =
          distance < reach
            ? Math.sign(dx || 1) * (1 - distance / reach) ** 2 * 46
            : 0
        blade.speed += (target - blade.push) * 0.09
        blade.speed *= 0.8
        blade.push += blade.speed

        const scale = blade.height / height
        const bend = blade.lean + (still ? 0 : wind) * scale * 1.6 + blade.push
        const tipX = blade.x + bend
        const midX = blade.x + bend * 0.35
        const midY = height - blade.height * 0.55
        const half = blade.width / 2

        // A tapered stroke: wide at the root, a point at the tip
        ctx.fillStyle = blade.colour
        ctx.beginPath()
        ctx.moveTo(blade.x - half, height + 2)
        ctx.quadraticCurveTo(midX - half, midY, tipX, tipY)
        ctx.quadraticCurveTo(midX + half, midY, blade.x + half, height + 2)
        ctx.fill()

        // A lighter edge, like a second pass of the brush
        ctx.strokeStyle = blade.highlight
        ctx.lineWidth = Math.max(0.6, half * 0.5)
        ctx.beginPath()
        ctx.moveTo(blade.x + half * 0.5, height + 2)
        ctx.quadraticCurveTo(midX + half * 0.4, midY, tipX, tipY)
        ctx.stroke()

        if (blade.head) {
          // A seed head: a short dab at the tip
          ctx.save()
          ctx.translate(tipX, tipY)
          ctx.rotate(Math.atan2(bend, blade.height) * 1.4)
          ctx.fillStyle = blade.highlight
          ctx.beginPath()
          ctx.ellipse(0, -4, 1.8 + half * 0.4, 6.5, 0, 0, Math.PI * 2)
          ctx.fill()
          ctx.restore()
        }
      }
    }

    const loop = (now: number) => {
      paint(now)
      frame = visible && !still ? requestAnimationFrame(loop) : 0
    }

    const start = () => {
      if (!frame && visible && !still) frame = requestAnimationFrame(loop)
    }

    // Only animate while the field is on screen
    new IntersectionObserver(entries => {
      visible = entries[0].isIntersecting
      start()
    }).observe(canvas)

    addEventListener('pointermove', event => {
      const box = canvas.getBoundingClientRect()
      pointerX = event.clientX - box.left
      pointerY = event.clientY - box.top
    })
    addEventListener('pointerleave', () => (pointerX = pointerY = -1e4))
    addEventListener('resize', resize)

    // Repaint in the other palette when the theme changes
    new MutationObserver(() => {
      plant()
      if (!frame) paint(performance.now())
    }).observe(root, { attributes: true, attributeFilter: ['class'] })

    resize()
  }
</script>
