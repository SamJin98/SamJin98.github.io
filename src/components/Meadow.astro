---
// The meadow at the foot of every page, painted loosely: one dark mass of
// grass in broad strokes, with a ragged top edge and soft smears of
// flowers. It sways in a slow wind and leans away from the pointer. With
// reduced motion it is painted once and left still.
---

<canvas class="meadow" aria-hidden="true"></canvas>

<style>
  /* Lies over the painted meadow at the foot of the page */
  .meadow {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: var(--meadow-height, calc(var(--paint-width) * 0.145));
    pointer-events: none;
  }
</style>

<script>
  interface Stroke {
    x: number
    y: number
    length: number
    width: number
    colour: string
    phase: number
    push: number
    speed: number
    flower: boolean
  }

  const palettes = {
    light: {
      top: '#5a6540',
      bottom: '#454f2e',
      tips: ['#56613c', '#5f6a42', '#4e5936'],
      hairs: ['rgb(134 144 94 / 0.22)', 'rgb(52 60 36 / 0.26)', 'rgb(108 118 74 / 0.2)'],
      flowers: ['#6f63b8', '#8d84c9', '#b4577f', '#c79a3a', '#b9b6c9', '#7f5aa6']
    },
    dark: {
      top: '#2a321e',
      bottom: '#1b2114',
      tips: ['#28301c', '#2e3721', '#232b19'],
      hairs: ['rgb(84 94 58 / 0.2)', 'rgb(16 20 11 / 0.3)', 'rgb(64 74 46 / 0.2)'],
      flowers: ['#4d4585', '#665f96', '#7d3f5c', '#8c6d2c', '#7f7d8c', '#59407a']
    }
  }

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.meadow')
  const ctx = canvas?.getContext('2d')

  if (canvas && ctx) {
    const root = document.documentElement
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches
    let palette = palettes.light
    let tips: Stroke[] = []
    let hairs: Stroke[] = []
    let flowers: Stroke[] = []
    let edge: number[] = []
    let width = 0
    let height = 0
    let pointerX = -1e4
    let pointerY = -1e4
    let visible = false
    let frame = 0

    // Seeded, so the field looks the same on every visit
    let seed = 7
    const random = () => {
      seed = (seed + 0x6d2b79f5) | 0
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed)
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296
    }
    const pick = <T,>(list: T[]) => list[Math.floor(random() * list.length)]

    // Where the mass of grass starts, as a gently uneven line
    const top = (x: number) =>
      height * (0.38 + 0.035 * Math.sin(x * 0.011) + 0.02 * Math.sin(x * 0.037 + 2))

    const plant = () => {
      palette = palettes[root.classList.contains('dark') ? 'dark' : 'light']
      seed = 7
      tips = []
      hairs = []
      flowers = []
      edge = []
      for (let x = 0; x <= width + 6; x += 6) edge.push(top(x))

      const make = (x: number, y: number, length: number, w: number, colour: string, flower = false): Stroke => ({
        x, y, length, width: w, colour, phase: random() * Math.PI * 2, push: 0, speed: 0, flower
      })

      // Ragged top edge: short blunt tips standing just above the mass
      for (let x = -6; x < width + 6; x += 2.2 + random() * 3.2)
        tips.push(make(x, top(x) + 3, height * (0.06 + random() * random() * 0.24), 5 + random() * 7, pick(palette.tips)))

      // The body: broad, faint strokes, lighter and darker than the ground
      const count = Math.round((width * height) / 260)
      for (let i = 0; i < count; i++) {
        const x = random() * width
        const y = top(x) + random() * (height - top(x)) + height * 0.06
        hairs.push(make(x, y, height * (0.16 + random() * 0.26), 3.5 + random() * 6, pick(palette.hairs)))
      }

      // Flowers: soft upright smears, a few to a clump, bigger lower down
      for (let x = random() * 40; x < width; x += 24 + random() * 60) {
        const depth = 0.3 + random() * 0.7
        const baseY = top(x) + (height - top(x)) * depth
        const colour = pick(palette.flowers)
        const size = 0.55 + depth * 0.75
        const n = 2 + Math.floor(random() * 3.4)
        for (let k = 0; k < n; k++)
          flowers.push(
            make(
              x + (random() - 0.5) * 26 * size,
              baseY + (random() - 0.5) * height * 0.12,
              height * (0.2 + random() * 0.24) * size,
              (6 + random() * 5) * size,
              random() < 0.75 ? colour : pick(palette.flowers),
              true
            )
          )
      }
      flowers.sort((a, b) => a.y - b.y)
    }

    const resize = () => {
      const box = canvas.getBoundingClientRect()
      // Drawn a little under screen resolution, which keeps the paint soft
      const ratio = Math.min(devicePixelRatio || 1, 2) * 0.55
      width = box.width
      height = box.height
      canvas.width = Math.round(width * ratio)
      canvas.height = Math.round(height * ratio)
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0)
      ctx.lineCap = 'round'
      plant()
      paint(performance.now())
    }

    // How far a stroke's top leans: wind plus the pointer pushing it aside
    const lean = (s: Stroke, t: number) => {
      const wind = still
        ? 0
        : Math.sin(t * 0.7 + s.x * 0.012) * 2.6 + Math.sin(t * 1.9 + s.phase) * 0.8
      const dx = s.x - pointerX
      const dy = s.y - s.length / 2 - pointerY
      const distance = Math.hypot(dx, dy)
      const reach = 80
      const target =
        distance < reach ? Math.sign(dx || 1) * (1 - distance / reach) ** 2 * 22 : 0
      s.speed += (target - s.push) * 0.1
      s.speed *= 0.78
      s.push += s.speed
      return (wind + s.push) * Math.min(1, s.length / (height * 0.2))
    }

    const paint = (now: number) => {
      const t = now / 1000
      ctx.clearRect(0, 0, width, height)

      // The mass of grass
      const fill = ctx.createLinearGradient(0, height * 0.38, 0, height)
      fill.addColorStop(0, palette.top)
      fill.addColorStop(1, palette.bottom)
      ctx.fillStyle = fill
      ctx.beginPath()
      ctx.moveTo(0, height)
      edge.forEach((y, i) => ctx.lineTo(i * 6, y))
      ctx.lineTo(width, height)
      ctx.fill()

      for (const s of tips) {
        const bend = lean(s, t)
        ctx.strokeStyle = s.colour
        ctx.lineWidth = s.width
        ctx.beginPath()
        ctx.moveTo(s.x, s.y)
        ctx.lineTo(s.x + bend, s.y - s.length)
        ctx.stroke()
      }

      for (const s of hairs) {
        const bend = lean(s, t)
        ctx.strokeStyle = s.colour
        ctx.lineWidth = s.width
        ctx.beginPath()
        ctx.moveTo(s.x, s.y)
        ctx.lineTo(s.x + bend, s.y - s.length)
        ctx.stroke()
      }

      for (const s of flowers) {
        const bend = lean(s, t) * 1.3
        ctx.save()
        ctx.translate(s.x + bend * 0.5, s.y - s.length / 2)
        ctx.rotate(Math.atan2(bend, s.length))
        ctx.globalAlpha = 0.72
        ctx.fillStyle = s.colour
        // A spindle: pointed at both ends, widest below the middle
        ctx.beginPath()
        ctx.moveTo(0, -s.length / 2)
        ctx.quadraticCurveTo(s.width, s.length * 0.12, 0, s.length / 2)
        ctx.quadraticCurveTo(-s.width, s.length * 0.12, 0, -s.length / 2)
        ctx.fill()
        // A lighter touch down one side, as if the brush was reloaded
        ctx.globalAlpha = 0.28
        ctx.fillStyle = '#fff'
        ctx.beginPath()
        ctx.moveTo(0, -s.length / 2)
        ctx.quadraticCurveTo(s.width * 0.9, s.length * 0.1, 0, s.length * 0.3)
        ctx.quadraticCurveTo(s.width * 0.25, 0, 0, -s.length / 2)
        ctx.fill()
        ctx.restore()
      }
    }

    const loop = (now: number) => {
      paint(now)
      frame = visible && !still ? requestAnimationFrame(loop) : 0
    }

    const start = () => {
      if (!frame && visible && !still) frame = requestAnimationFrame(loop)
    }

    // Only animate while the field is on screen
    new IntersectionObserver(entries => {
      visible = entries[0].isIntersecting
      start()
    }).observe(canvas)

    addEventListener('pointermove', event => {
      const box = canvas.getBoundingClientRect()
      pointerX = event.clientX - box.left
      pointerY = event.clientY - box.top
    })
    document.addEventListener('pointerleave', () => (pointerX = pointerY = -1e4))
    addEventListener('resize', resize)

    // Repaint in the other palette when the theme changes
    new MutationObserver(() => {
      plant()
      if (!frame) paint(performance.now())
    }).observe(root, { attributes: true, attributeFilter: ['class'] })

    resize()
  }
</script>
