---
// The meadow at the foot of every page, painted in two steps on the GPU.
// First the field itself is drawn: a few thousand touches of grass and
// flowers, each bent into an arc by the wind, by gusts crossing the field,
// and by the animals that wander through now and then. The pointer combs
// the grass the way it moves, and the trail it leaves springs back slowly.
// Then the whole picture is worked over like thick oil paint: colours are
// pulled into flat dabs, and the dabs are lit from the upper left so their
// edges and bristle furrows catch the light.
// With reduced motion it is painted once and left still, with no animals.
// Without WebGL 2 the canvas stays empty and the painted ground shows.
---

<canvas class="meadow" aria-hidden="true"></canvas>

<style>
  /* Lies over the painted meadow at the foot of the page */
  .meadow {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: var(--meadow-height, calc(var(--paint-width) * 0.145));
    pointer-events: none;
  }
</style>

<script>
  type RGB = [number, number, number]

  interface Animal {
    kind: number // which cell of the sprite sheet
    x: number
    y: number // where its feet stand
    size: number // height on screen
    direction: 1 | -1
    born: number
    life: number
    pace: number
    phase: number
  }

  const palettes = {
    light: {
      groundFar: [122, 136, 62] as RGB,
      groundNear: [58, 78, 36] as RGB,
      far: [150, 160, 76] as RGB,
      near: [66, 94, 44] as RGB,
      // Odd touches mixed into the greens: straw, lime, a cool blue-green
      accents: [[204, 186, 92], [176, 194, 88], [74, 110, 70], [220, 206, 128]] as RGB[],
      flowers: [
        [122, 108, 196],
        [154, 144, 208],
        [192, 87, 127],
        [214, 162, 51],
        [232, 228, 236],
        [233, 178, 60],
        [207, 74, 58]
      ] as RGB[],
      relief: 1,
      shine: 0.36
    },
    dark: {
      groundFar: [50, 60, 34] as RGB,
      groundNear: [22, 31, 17] as RGB,
      far: [66, 78, 42] as RGB,
      near: [26, 38, 22] as RGB,
      accents: [[92, 88, 46], [76, 92, 48], [24, 50, 46], [100, 96, 64]] as RGB[],
      flowers: [
        [84, 75, 143],
        [108, 100, 156],
        [132, 65, 95],
        [147, 114, 45],
        [138, 136, 150],
        [154, 122, 48],
        [138, 58, 48]
      ] as RGB[],
      relief: 0.8,
      shine: 0.22
    }
  }

  // Shared by every shader that needs to know where the field starts
  const TOP = /* glsl */ `
    float top(float x) {
      return uSize.y * (0.36 + 0.035 * sin(x * 0.011) + 0.02 * sin(x * 0.037 + 2.0));
    }`

  const NOISE = /* glsl */ `
    float hash(vec2 p) {
      p = fract(p * vec2(123.34, 456.21));
      p += dot(p, p + 45.32);
      return fract(p.x * p.y);
    }
    float noise(vec2 p) {
      vec2 i = floor(p), f = fract(p);
      f = f * f * (3.0 - 2.0 * f);
      return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x),
                 mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);
    }`

  const QUAD_VS = /* glsl */ `#version 300 es
    layout(location = 0) in vec2 aCorner;
    out vec2 vUv;
    void main() {
      vUv = aCorner * 0.5 + 0.5;
      gl_Position = vec4(aCorner, 0.0, 1.0);
    }`

  // The earth under the grass, so nothing shows between the touches
  const GROUND_FS = /* glsl */ `#version 300 es
    precision highp float;
    uniform vec2 uSize;
    uniform vec3 uGroundFar, uGroundNear;
    in vec2 vUv;
    out vec4 outColor;
    ${TOP}
    ${NOISE}
    void main() {
      vec2 p = vec2(vUv.x, 1.0 - vUv.y) * uSize;
      float edge = top(p.x) + 5.0;
      if (p.y < edge) discard;
      float depth = (p.y - edge) / (uSize.y - edge);
      vec3 c = mix(uGroundFar, uGroundNear, depth) * (0.9 + 0.2 * noise(p * 0.06));
      outColor = vec4(c, 1.0);
    }`

  // The trail the pointer leaves: how far the grass is combed left or
  // right at each spot. It fades a little every frame, and the pointer
  // adds to it along its path, in the direction it is moving.
  const TRAIL_FS = /* glsl */ `#version 300 es
    precision highp float;
    uniform sampler2D uTrail;
    uniform vec2 uSize;
    uniform vec4 uStroke;  // from x, y, to x, y
    uniform vec2 uComb;    // direction -1..1, strength
    in vec2 vUv;
    out vec4 outColor;
    void main() {
      float lean = texture(uTrail, vUv).r * 2.0 - 1.0;
      lean *= 0.965;
      lean -= sign(lean) * min(abs(lean), 0.004);
      vec2 p = vec2(vUv.x, 1.0 - vUv.y) * uSize;
      vec2 a = uStroke.xy, b = uStroke.zw;
      vec2 ab = b - a;
      float along = clamp(dot(p - a, ab) / max(dot(ab, ab), 1e-4), 0.0, 1.0);
      float d = length((p - (a + ab * along)) * vec2(1.0, 1.25));
      float touch = exp(-d * d / (46.0 * 46.0)) * uComb.y;
      lean = mix(lean, uComb.x, clamp(touch, 0.0, 1.0));
      outColor = vec4(lean * 0.5 + 0.5, 0.0, 0.0, 1.0);
    }`

  // One touch of grass or one flower smear, bent into an arc
  const BLADE_VS = /* glsl */ `#version 300 es
    precision highp float;
    layout(location = 0) in vec2 aBlade; // side -1..1, along 0..1
    layout(location = 1) in vec4 aRoot;  // x, depth, two seeds
    layout(location = 2) in vec4 aKind;  // flower, seed, height, width
    uniform vec2 uSize;
    uniform float uTime, uMotion;
    uniform sampler2D uTrail;
    uniform vec4 uMobs[4];   // x, y, reach, strength
    uniform vec3 uFar, uNear;
    uniform vec3 uAccents[4];
    uniform vec3 uFlowers[7];
    out vec3 vColour;
    ${TOP}
    float rnd(float s, float k) { return fract(sin(s * k) * 43758.5453); }
    void main() {
      float x = aRoot.x, depth = aRoot.y, flower = aKind.x, seed = aKind.y;
      float size = 0.7 + depth * 0.8;
      float edge = top(x);
      float y = edge + (uSize.y - edge) * depth * 1.04 + (aRoot.z - 0.2) * 7.0 * size;
      float h = aKind.z * size, w = aKind.w * size;

      // Wind: a steady lean, a wave rolling across the field, gusts that
      // travel through it, and each touch's own flutter
      float gust = pow(max(0.0, sin(uTime * 0.33 - x * 0.0035)), 3.0);
      float wind = 0.1
        + sin(uTime * 1.1 + x * 0.012 + y * 0.03) * 0.2
        + gust * 0.42
        + sin(uTime * 2.6 + aRoot.w * 6.283) * (0.05 + gust * 0.09);

      // The pointer's trail combs the touches over; animals push them aside
      float combed = texture(uTrail, vec2(x / uSize.x, 1.0 - (y - h * 0.4) / uSize.y)).r * 2.0 - 1.0;
      float push = combed * 1.5;
      for (int i = 0; i < 4; i++) {
        vec2 from = vec2(x, y) - uMobs[i].xy;
        push += sign(from.x) * pow(max(0.0, 1.0 - length(from * vec2(1.0, 2.2)) / max(uMobs[i].z, 1.0)), 2.0)
          * 0.9 * uMobs[i].w;
      }

      float lean = (aRoot.w - 0.5) * mix(0.8, 0.3, flower);
      // Combed grass lies flatter and moves less in the wind
      float bend = lean * (1.0 - abs(combed) * 0.7)
        + wind * uMotion * mix(1.0, 0.8, flower) * (1.0 - abs(combed) * 0.6) + push;
      float s = aBlade.y;
      float arc = bend * s;
      vec2 spine = vec2(x, y) + vec2(sin(arc), -cos(arc)) * h * s;
      vec2 across = vec2(cos(arc), sin(arc));
      // Grass is round at the foot and drawn up to a point; a flower is a
      // spindle, pointed at both ends
      float leaf = pow(1.0 - s, 0.7) * (0.55 + 0.45 * smoothstep(0.0, 0.2, s));
      float spindle = pow(sin(3.14159 * clamp(s, 0.0, 1.0)), 0.8);
      vec2 p = spine + across * aBlade.x * w * 0.5 * mix(leaf, spindle, flower);

      float mixed = clamp(depth + (rnd(seed, 127.1) - 0.5) * 0.5, 0.0, 1.0);
      vec3 green = mix(uFar, uNear, mixed) * mix(0.8, 1.18, rnd(seed, 311.7));
      if (rnd(seed, 74.7) < 0.14 * (1.2 - depth)) green = uAccents[int(rnd(seed, 19.3) * 3.99)];
      // Darker at the foot, lighter toward the tip and on the lit side
      green *= mix(0.7, 1.14, s) * (1.0 - aBlade.x * 0.1);
      // Combed over, a touch shows more of its lit side
      green *= 1.0 + abs(combed) * 0.22;
      vec3 petal = uFlowers[int(rnd(seed, 53.9) * 6.99)] * mix(0.86, 1.08, s);
      vColour = mix(green, petal, flower) / 255.0;

      // Nearer touches cover farther ones; flowers go in a little late
      float order = (y + flower * h * 0.55) / uSize.y;
      gl_Position = vec4(p.x / uSize.x * 2.0 - 1.0, 1.0 - p.y / uSize.y * 2.0, 0.9 - order * 0.9, 1.0);
    }`

  const BLADE_FS = /* glsl */ `#version 300 es
    precision highp float;
    in vec3 vColour;
    out vec4 outColor;
    void main() { outColor = vec4(vColour, 1.0); }`

  // A sheep or a cow, one cell of the sprite sheet
  const MOB_VS = /* glsl */ `#version 300 es
    precision highp float;
    layout(location = 0) in vec2 aCorner;
    uniform vec2 uSize;
    uniform vec4 uRect;  // centre x, feet y, width, height
    uniform vec3 uCell;  // cell, cells, direction
    out vec2 vUv;
    void main() {
      vec2 uv = aCorner * 0.5 + 0.5;
      float u = uCell.z > 0.0 ? uv.x : 1.0 - uv.x;
      vUv = vec2((uCell.x + u) / uCell.y, 1.0 - uv.y);
      vec2 p = vec2(uRect.x + aCorner.x * uRect.z * 0.5, uRect.y - uv.y * uRect.w);
      float order = (uRect.y + 10.0) / uSize.y;
      gl_Position = vec4(p.x / uSize.x * 2.0 - 1.0, 1.0 - p.y / uSize.y * 2.0, 0.9 - order * 0.9, 1.0);
    }`

  const MOB_FS = /* glsl */ `#version 300 es
    precision highp float;
    uniform sampler2D uSheet;
    uniform float uAlpha;
    in vec2 vUv;
    out vec4 outColor;
    void main() {
      vec4 c = texture(uSheet, vUv);
      float a = c.a * uAlpha;
      if (a < 0.02) discard;
      outColor = vec4(c.rgb * a, a);
    }`

  // Pulls the picture into flat dabs: around every point, the calmest of
  // four neighbouring patches gives its average colour
  const DAB_FS = /* glsl */ `#version 300 es
    precision highp float;
    uniform sampler2D uScene;
    uniform vec2 uStep;
    in vec2 vUv;
    out vec4 outColor;
    void main() {
      vec4 sum[4];
      vec4 squares[4];
      for (int k = 0; k < 4; k++) { sum[k] = vec4(0.0); squares[k] = vec4(0.0); }
      for (int j = -3; j <= 3; j++) {
        for (int i = -3; i <= 3; i++) {
          vec4 c = texture(uScene, vUv + vec2(float(i), float(j)) * uStep);
          vec4 cc = c * c;
          if (i <= 0 && j <= 0) { sum[0] += c; squares[0] += cc; }
          if (i >= 0 && j <= 0) { sum[1] += c; squares[1] += cc; }
          if (i <= 0 && j >= 0) { sum[2] += c; squares[2] += cc; }
          if (i >= 0 && j >= 0) { sum[3] += c; squares[3] += cc; }
        }
      }
      float calmest = 1e9;
      vec4 chosen = vec4(0.0);
      for (int k = 0; k < 4; k++) {
        vec4 mean = sum[k] / 16.0;
        vec4 spread = abs(squares[k] / 16.0 - mean * mean);
        float v = spread.r + spread.g + spread.b + spread.a;
        if (v < calmest) { calmest = v; chosen = mean; }
      }
      outColor = chosen;
    }`

  // Lights the dabs as thick paint: where one colour meets the next there
  // is a ridge, and the bristles leave furrows running up the strokes
  const RELIEF_FS = /* glsl */ `#version 300 es
    precision highp float;
    uniform sampler2D uPaint;
    uniform vec2 uStep, uSize;
    uniform float uRelief, uShine;
    in vec2 vUv;
    out vec4 outColor;
    ${NOISE}
    float height(vec2 uv) {
      vec4 c = texture(uPaint, uv);
      vec2 p = vec2(uv.x, 1.0 - uv.y) * uSize;
      float furrows = noise(vec2(p.x * 0.85, p.y * 0.13)) * 0.5 + noise(vec2(p.x * 0.3, p.y * 0.07)) * 0.5;
      return dot(c.rgb, vec3(0.9, 1.4, 0.7)) + c.a * (0.6 + furrows * 0.55);
    }
    void main() {
      vec4 c = texture(uPaint, vUv);
      float dx = height(vUv + vec2(uStep.x, 0.0)) - height(vUv - vec2(uStep.x, 0.0));
      float dy = height(vUv - vec2(0.0, uStep.y)) - height(vUv + vec2(0.0, uStep.y));
      // Light from the upper left
      float shade = clamp((dx * 0.62 + dy * 0.78) * 2.0 * uRelief, -1.0, 1.0);
      vec3 lit = c.rgb * (1.0 + shade * 0.5) + c.a * uShine * pow(max(shade, 0.0), 2.0) * vec3(1.0, 0.97, 0.86);
      outColor = vec4(lit, c.a);
    }`

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.meadow')
  const gl = canvas?.getContext('webgl2', { antialias: false, depth: false })

  if (canvas && gl) {
    const root = document.documentElement
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches
    const theme = () => (root.classList.contains('dark') ? 'dark' : 'light')
    let width = 0
    let height = 0
    let count = 0
    let visible = false
    let frame = 0
    let last = 0
    const pointer = { x: -1e4, y: -1e4, fromX: -1e4, fromY: -1e4, targetX: -1e4, targetY: -1e4, comb: 0 }

    const program = (vertex: string, fragment: string) => {
      const made = gl.createProgram()!
      for (const [type, source] of [
        [gl.VERTEX_SHADER, vertex],
        [gl.FRAGMENT_SHADER, fragment]
      ] as const) {
        const shader = gl.createShader(type)!
        gl.shaderSource(shader, source)
        gl.compileShader(shader)
        if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS))
          console.warn('meadow shader', gl.getShaderInfoLog(shader))
        gl.attachShader(made, shader)
      }
      gl.linkProgram(made)
      const uniforms: Record<string, WebGLUniformLocation | null> = {}
      const n = gl.getProgramParameter(made, gl.ACTIVE_UNIFORMS)
      for (let i = 0; i < n; i++) {
        const name = gl.getActiveUniform(made, i)!.name.replace('[0]', '')
        uniforms[name] = gl.getUniformLocation(made, name)
      }
      return { made, uniforms }
    }

    const ground = program(QUAD_VS, GROUND_FS)
    const blades = program(BLADE_VS, BLADE_FS)
    const mobs = program(MOB_VS, MOB_FS)
    const trailer = program(QUAD_VS, TRAIL_FS)
    const dab = program(QUAD_VS, DAB_FS)
    const relief = program(QUAD_VS, RELIEF_FS)

    // A square for the full-picture passes and the animals
    const quad = gl.createVertexArray()
    gl.bindVertexArray(quad)
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer())
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW)
    gl.enableVertexAttribArray(0)
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0)

    // One touch: a ribbon of five steps, drawn once per root
    const SEGMENTS = 5
    const ribbon: number[] = []
    for (let k = 0; k <= SEGMENTS; k++) ribbon.push(-1, k / SEGMENTS, 1, k / SEGMENTS)
    const field = gl.createVertexArray()
    gl.bindVertexArray(field)
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer())
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(ribbon), gl.STATIC_DRAW)
    gl.enableVertexAttribArray(0)
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0)
    const roots = gl.createBuffer()
    gl.bindBuffer(gl.ARRAY_BUFFER, roots)
    for (const [location, offset] of [
      [1, 0],
      [2, 16]
    ]) {
      gl.enableVertexAttribArray(location)
      gl.vertexAttribPointer(location, 4, gl.FLOAT, false, 32, offset)
      gl.vertexAttribDivisor(location, 1)
    }
    gl.bindVertexArray(null)

    // Two pictures to paint into: the field, then the field in dabs
    const target = (depth: boolean) => ({
      texture: gl.createTexture(),
      buffer: gl.createFramebuffer(),
      store: depth ? gl.createRenderbuffer() : null
    })
    const scene = target(true)
    const dabbed = target(false)
    // The pointer's trail, kept small and swapped between two pictures
    let trail = [target(false), target(false)]
    const trailSize = { width: 1, height: 1 }
    const size = (t: ReturnType<typeof target>, w: number, h: number) => {
      gl.bindTexture(gl.TEXTURE_2D, t.texture)
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA8, w, h, 0, gl.RGBA, gl.UNSIGNED_BYTE, null)
      for (const [key, value] of [
        [gl.TEXTURE_MIN_FILTER, gl.LINEAR],
        [gl.TEXTURE_MAG_FILTER, gl.LINEAR],
        [gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE],
        [gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE]
      ])
        gl.texParameteri(gl.TEXTURE_2D, key, value)
      gl.bindFramebuffer(gl.FRAMEBUFFER, t.buffer)
      gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, t.texture, 0)
      if (t.store) {
        gl.bindRenderbuffer(gl.RENDERBUFFER, t.store)
        gl.renderbufferStorage(gl.RENDERBUFFER, gl.DEPTH_COMPONENT16, w, h)
        gl.framebufferRenderbuffer(gl.FRAMEBUFFER, gl.DEPTH_ATTACHMENT, gl.RENDERBUFFER, t.store)
      }
    }

    // The animals: two cells of one sprite sheet per theme, facing right
    const cell = { width: 320, height: 220, count: 2 }
    const sheets = Object.fromEntries(
      (['light', 'dark'] as const).map(name => {
        const sheet = { texture: gl.createTexture(), ready: false }
        const image = new Image()
        image.onload = () => {
          gl.bindTexture(gl.TEXTURE_2D, sheet.texture)
          gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, image)
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR)
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE)
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE)
          sheet.ready = true
        }
        if (!still) image.src = `/paint/animals-${name}.webp`
        return [name, sheet]
      })
    )
    let animals: Animal[] = []
    let nextAnimal = performance.now() / 1000 + 3

    // Seeded, so the field looks the same on every visit
    let seed = 7
    const random = () => {
      seed = (seed + 0x6d2b79f5) | 0
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed)
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296
    }

    const top = (x: number) =>
      height * (0.36 + 0.035 * Math.sin(x * 0.011) + 0.02 * Math.sin(x * 0.037 + 2))

    const plant = () => {
      seed = 7
      const data: number[] = []

      // Rows of touches from the far edge to the near one, growing toward
      // the viewer
      const rows = Math.max(8, Math.round(height / 7))
      for (let row = 0; row < rows; row++) {
        const depth = row / (rows - 1)
        const gap = 4.6 * (0.7 + depth * 0.8)
        for (let x = -gap + random() * gap; x < width + gap; x += gap * (0.7 + random() * 0.6))
          data.push(x, depth, random(), random(), 0, random(), 15 + random() * 15, 8 + random() * 6)
      }

      // Flowers: soft upright smears, a few to a clump
      for (let x = random() * 40; x < width; x += 36 + random() * 80) {
        const depth = 0.2 + random() * 0.8
        const colour = random()
        const n = 1 + Math.floor(random() * 3.4)
        for (let k = 0; k < n; k++)
          data.push(
            x + (random() - 0.5) * 28 * (0.6 + depth * 0.8),
            depth,
            random(),
            random(),
            1,
            random() < 0.75 ? colour : random(),
            13 + random() * 13,
            5 + random() * 3.5
          )
      }

      count = data.length / 8
      gl.bindBuffer(gl.ARRAY_BUFFER, roots)
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(data), gl.STATIC_DRAW)
    }

    // Now and then one wanders in, ambles a little way with pauses to
    // graze, and fades out again
    const herd = (t: number, dt: number) => {
      animals = animals.filter(animal => t - animal.born < animal.life)
      for (const animal of animals) {
        const stride = Math.max(0, Math.sin((t - animal.born) * 0.45 + animal.phase))
        animal.x += animal.direction * animal.pace * stride * dt
      }
      if (still || t < nextAnimal || animals.length >= 2) return
      nextAnimal = t + 9 + Math.random() * 16
      const depth = 0.12 + Math.random() * 0.42
      const x = width * (0.06 + Math.random() * 0.88)
      const kind = Math.random() < 0.6 ? 0 : 1
      animals.push({
        kind,
        x,
        y: top(x) + (height - top(x)) * depth,
        size: height * (kind ? 0.62 : 0.5) * (0.8 + depth * 0.5),
        direction: Math.random() < 0.5 ? 1 : -1,
        born: t,
        life: 16 + Math.random() * 12,
        pace: 7 + Math.random() * 6,
        phase: Math.random() * 6
      })
    }

    const paint = (now: number) => {
      const t = now / 1000
      const dt = Math.min(0.1, last ? t - last : 0)
      last = t
      const palette = palettes[theme()]
      herd(t, dt)
      const fade = (animal: Animal) =>
        Math.max(0, Math.min(1, (t - animal.born) / 2.5, (animal.life - (t - animal.born)) / 2.5))

      // The trail: fade what is there, then comb along the pointer's path
      pointer.fromX = pointer.x
      pointer.fromY = pointer.y
      pointer.x += (pointer.targetX - pointer.x) * 0.35
      pointer.y += (pointer.targetY - pointer.y) * 0.35
      const moved = pointer.x - pointer.fromX
      const speed = Math.hypot(moved, pointer.y - pointer.fromY)
      const jumped = speed > 400
      pointer.comb += (Math.max(-1, Math.min(1, moved / 9)) - pointer.comb) * 0.3
      gl.disable(gl.DEPTH_TEST)
      gl.disable(gl.BLEND)
      gl.bindFramebuffer(gl.FRAMEBUFFER, trail[1].buffer)
      gl.viewport(0, 0, trailSize.width, trailSize.height)
      gl.useProgram(trailer.made)
      gl.activeTexture(gl.TEXTURE0)
      gl.bindTexture(gl.TEXTURE_2D, trail[0].texture)
      gl.uniform1i(trailer.uniforms.uTrail, 0)
      gl.uniform2f(trailer.uniforms.uSize, width, height)
      gl.uniform4f(trailer.uniforms.uStroke, pointer.fromX, pointer.fromY, pointer.x, pointer.y)
      gl.uniform2f(trailer.uniforms.uComb, pointer.comb, jumped || still ? 0 : Math.min(1, speed / 5) * 0.7)
      gl.bindVertexArray(quad)
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4)
      trail = [trail[1], trail[0]]

      // 1. The field
      gl.bindFramebuffer(gl.FRAMEBUFFER, scene.buffer)
      gl.viewport(0, 0, canvas.width, canvas.height)
      gl.clearColor(0, 0, 0, 0)
      gl.depthMask(true)
      gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT)
      gl.disable(gl.BLEND)

      gl.disable(gl.DEPTH_TEST)
      gl.useProgram(ground.made)
      gl.uniform2f(ground.uniforms.uSize, width, height)
      gl.uniform3fv(ground.uniforms.uGroundFar, palette.groundFar.map(v => v / 255))
      gl.uniform3fv(ground.uniforms.uGroundNear, palette.groundNear.map(v => v / 255))
      gl.bindVertexArray(quad)
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4)

      gl.enable(gl.DEPTH_TEST)
      gl.depthFunc(gl.LEQUAL)
      gl.useProgram(blades.made)
      gl.uniform2f(blades.uniforms.uSize, width, height)
      gl.uniform1f(blades.uniforms.uTime, t)
      gl.uniform1f(blades.uniforms.uMotion, still ? 0 : 1)
      gl.activeTexture(gl.TEXTURE0)
      gl.bindTexture(gl.TEXTURE_2D, trail[0].texture)
      gl.uniform1i(blades.uniforms.uTrail, 0)
      const pushes = new Float32Array(16)
      animals
        .slice(0, 4)
        .forEach((animal, i) => pushes.set([animal.x, animal.y, animal.size * 0.9, fade(animal)], i * 4))
      gl.uniform4fv(blades.uniforms.uMobs, pushes)
      gl.uniform3fv(blades.uniforms.uFar, palette.far)
      gl.uniform3fv(blades.uniforms.uNear, palette.near)
      gl.uniform3fv(blades.uniforms.uAccents, palette.accents.flat())
      gl.uniform3fv(blades.uniforms.uFlowers, palette.flowers.flat())
      gl.bindVertexArray(field)
      gl.drawArraysInstanced(gl.TRIANGLE_STRIP, 0, (SEGMENTS + 1) * 2, count)

      // The animals stand in the grass: touches in front of their feet
      // were drawn nearer and cover them
      const sheet = sheets[theme()]
      if (sheet.ready && animals.length) {
        gl.enable(gl.BLEND)
        gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA)
        gl.depthMask(false)
        gl.useProgram(mobs.made)
        gl.uniform2f(mobs.uniforms.uSize, width, height)
        gl.activeTexture(gl.TEXTURE0)
        gl.bindTexture(gl.TEXTURE_2D, sheet.texture)
        gl.uniform1i(mobs.uniforms.uSheet, 0)
        gl.bindVertexArray(quad)
        for (const animal of animals) {
          const age = t - animal.born
          const stride = Math.max(0, Math.sin(age * 0.45 + animal.phase))
          const bob = Math.sin(age * 5 + animal.phase) * stride * 0.8
          gl.uniform4f(
            mobs.uniforms.uRect,
            animal.x,
            animal.y + bob,
            (animal.size * cell.width) / cell.height,
            animal.size
          )
          gl.uniform3f(mobs.uniforms.uCell, animal.kind, cell.count, animal.direction)
          gl.uniform1f(mobs.uniforms.uAlpha, fade(animal))
          gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4)
        }
        gl.depthMask(true)
        gl.disable(gl.BLEND)
      }

      // 2. Into dabs
      gl.disable(gl.DEPTH_TEST)
      gl.bindVertexArray(quad)
      gl.activeTexture(gl.TEXTURE0)
      const reach = canvas.width / width
      gl.bindFramebuffer(gl.FRAMEBUFFER, dabbed.buffer)
      gl.useProgram(dab.made)
      gl.bindTexture(gl.TEXTURE_2D, scene.texture)
      gl.uniform1i(dab.uniforms.uScene, 0)
      gl.uniform2f(dab.uniforms.uStep, (reach * 0.9) / canvas.width, (reach * 0.9) / canvas.height)
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4)

      // 3. Lit as thick paint, onto the page
      gl.bindFramebuffer(gl.FRAMEBUFFER, null)
      gl.clear(gl.COLOR_BUFFER_BIT)
      gl.useProgram(relief.made)
      gl.bindTexture(gl.TEXTURE_2D, dabbed.texture)
      gl.uniform1i(relief.uniforms.uPaint, 0)
      gl.uniform2f(relief.uniforms.uStep, reach / canvas.width, reach / canvas.height)
      gl.uniform2f(relief.uniforms.uSize, width, height)
      gl.uniform1f(relief.uniforms.uRelief, palette.relief)
      gl.uniform1f(relief.uniforms.uShine, palette.shine)
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4)
    }

    const resize = () => {
      const box = canvas.getBoundingClientRect()
      const ratio = Math.min(devicePixelRatio || 1, 2)
      width = box.width
      height = box.height
      canvas.width = Math.max(1, Math.round(width * ratio))
      canvas.height = Math.max(1, Math.round(height * ratio))
      size(scene, canvas.width, canvas.height)
      size(dabbed, canvas.width, canvas.height)
      trailSize.width = Math.max(1, Math.ceil(width / 5))
      trailSize.height = Math.max(1, Math.ceil(height / 5))
      for (const t of trail) {
        size(t, trailSize.width, trailSize.height)
        gl.clearColor(0.5, 0, 0, 1)
        gl.clear(gl.COLOR_BUFFER_BIT)
      }
      animals = []
      plant()
      paint(performance.now())
    }

    const loop = (now: number) => {
      paint(now)
      frame = visible && !still ? requestAnimationFrame(loop) : 0
    }

    const start = () => {
      if (!frame && visible && !still) frame = requestAnimationFrame(loop)
    }

    // Only animate while the field is on screen
    new IntersectionObserver(entries => {
      visible = entries[0].isIntersecting
      last = 0
      start()
    }).observe(canvas)

    addEventListener('pointermove', event => {
      const box = canvas.getBoundingClientRect()
      pointer.targetX = event.clientX - box.left
      pointer.targetY = event.clientY - box.top
      // Coming in from outside, start the stroke where the pointer is
      if (pointer.x < -5e3 || Math.abs(pointer.targetY - pointer.y) > 300) {
        pointer.x = pointer.targetX
        pointer.y = pointer.targetY
      }
    })
    addEventListener('resize', resize)

    // Repaint in the other palette when the theme changes
    new MutationObserver(() => {
      if (!frame) paint(performance.now())
    }).observe(root, { attributes: true, attributeFilter: ['class'] })

    resize()
  }
</script>
