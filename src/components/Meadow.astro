---
// The meadow at the foot of every page, painted the way a field is dabbed in
// oils: rows of short leaf-shaped touches laid over each other from the back
// to the front, yellower at the far edge and deeper green near the viewer,
// with soft smears of flowers standing among them. It sways in a slow wind
// and leans away from the pointer. With reduced motion it is painted once
// and left still.
---

<canvas class="meadow" aria-hidden="true"></canvas>

<style>
  /* Lies over the painted meadow at the foot of the page */
  .meadow {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: var(--meadow-height, calc(var(--paint-width) * 0.145));
    pointer-events: none;
  }
</style>

<script>
  interface Dab {
    x: number
    y: number
    height: number
    width: number
    colour: string
    phase: number
    push: number
    speed: number
    flower: boolean
  }

  type RGB = [number, number, number]

  const palettes = {
    light: {
      ground: '#4f6230',
      far: [142, 152, 74] as RGB,
      near: [70, 92, 42] as RGB,
      flowers: ['#7a6cc4', '#9a90d0', '#c0577f', '#d6a233', '#e4e0ea', '#e9b23c']
    },
    dark: {
      ground: '#1f2716',
      far: [62, 72, 40] as RGB,
      near: [28, 37, 20] as RGB,
      flowers: ['#544b8f', '#6c649c', '#84415f', '#93722d', '#8a8896', '#9a7a30']
    }
  }

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.meadow')
  const ctx = canvas?.getContext('2d')

  if (canvas && ctx) {
    const root = document.documentElement
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches
    let palette = palettes.light
    let dabs: Dab[] = []
    let width = 0
    let height = 0
    let pointerX = -1e4
    let pointerY = -1e4
    let visible = false
    let frame = 0

    // Seeded, so the field looks the same on every visit
    let seed = 7
    const random = () => {
      seed = (seed + 0x6d2b79f5) | 0
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed)
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296
    }
    const pick = <T,>(list: T[]) => list[Math.floor(random() * list.length)]

    // Where the field starts, as a gently uneven line
    const top = (x: number) =>
      height * (0.36 + 0.035 * Math.sin(x * 0.011) + 0.02 * Math.sin(x * 0.037 + 2))

    const plant = () => {
      palette = palettes[root.classList.contains('dark') ? 'dark' : 'light']
      seed = 7
      dabs = []

      // Rows of leaf-shaped touches from the far edge to the near one. Each
      // row overlaps the one behind it; touches grow and deepen in colour
      // toward the viewer, and every one is mixed a little differently.
      const rows = Math.max(8, Math.round(height / 9))
      for (let row = 0; row < rows; row++) {
        const depth = row / (rows - 1)
        const size = 0.7 + depth * 0.8
        const gap = 5.2 * size
        for (let x = -gap + random() * gap; x < width + gap; x += gap * (0.7 + random() * 0.6)) {
          const y = top(x) + (height - top(x)) * depth * 1.04 + (random() - 0.2) * 7 * size
          const mix = Math.min(1, Math.max(0, depth + (random() - 0.5) * 0.45))
          const tone = 0.88 + random() * 0.26
          const warm = random() < 0.12 ? 1.12 : 1
          const c = palette.far.map((far, i) =>
            Math.round(Math.min(255, (far + (palette.near[i] - far) * mix) * tone * (i === 2 ? 1 : warm)))
          )
          dabs.push({
            x,
            y,
            height: (13 + random() * 13) * size,
            width: (5 + random() * 4.5) * size,
            colour: `rgb(${c[0]} ${c[1]} ${c[2]})`,
            phase: random() * Math.PI * 2,
            push: 0,
            speed: 0,
            flower: false
          })
        }
      }

      // Flowers: soft upright smears, a few to a clump, bigger lower down
      for (let x = random() * 40; x < width; x += 30 + random() * 70) {
        const depth = 0.2 + random() * 0.8
        const baseY = top(x) + (height - top(x)) * depth
        const colour = pick(palette.flowers)
        const size = 0.6 + depth * 0.8
        const n = 1 + Math.floor(random() * 3.4)
        for (let k = 0; k < n; k++)
          dabs.push({
            x: x + (random() - 0.5) * 28 * size,
            y: baseY + (random() - 0.5) * 10,
            height: (22 + random() * 22) * size,
            width: (4.5 + random() * 4) * size,
            colour: random() < 0.75 ? colour : pick(palette.flowers),
            phase: random() * Math.PI * 2,
            push: 0,
            speed: 0,
            flower: true
          })
      }

      // Painted back to front, so nearer touches cover the feet of farther
      // ones. Flowers go in a little late, which keeps their heads clear.
      const order = (dab: Dab) => dab.y + (dab.flower ? dab.height * 0.55 : 0)
      dabs.sort((a, b) => order(a) - order(b))
    }

    const resize = () => {
      const box = canvas.getBoundingClientRect()
      // Drawn a little under screen resolution, which keeps the paint soft
      const ratio = Math.min(devicePixelRatio || 1, 2) * 0.6
      width = box.width
      height = box.height
      canvas.width = Math.round(width * ratio)
      canvas.height = Math.round(height * ratio)
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0)
      plant()
      paint(performance.now())
    }

    const paint = (now: number) => {
      const t = now / 1000
      ctx.clearRect(0, 0, width, height)

      // Ground colour under the touches, so no paper shows between them
      ctx.fillStyle = palette.ground
      ctx.beginPath()
      ctx.moveTo(0, height)
      for (let x = 0; x <= width + 8; x += 8) ctx.lineTo(x, top(x) + 4)
      ctx.lineTo(width, height)
      ctx.fill()

      for (const dab of dabs) {
        // Wind: one slow wave across the field plus each touch's own flutter
        const wind = still
          ? 0
          : Math.sin(t * 0.7 + dab.x * 0.012 + dab.y * 0.03) * 2.2 +
            Math.sin(t * 1.9 + dab.phase) * 0.7

        // The pointer pushes nearby touches aside; a spring brings them back
        const dx = dab.x - pointerX
        const dy = dab.y - dab.height / 2 - pointerY
        const distance = Math.hypot(dx, dy)
        const reach = 80
        const target =
          distance < reach ? Math.sign(dx || 1) * (1 - distance / reach) ** 2 * 20 : 0
        dab.speed += (target - dab.push) * 0.1
        dab.speed *= 0.78
        dab.push += dab.speed

        const bend = (wind + dab.push) * (dab.flower ? 1.2 : dab.height / 22)
        const half = dab.width / 2
        const tipX = dab.x + bend
        const tipY = dab.y - dab.height

        if (dab.flower) {
          ctx.save()
          ctx.translate(dab.x + bend * 0.5, dab.y - dab.height / 2)
          ctx.rotate(Math.atan2(bend, dab.height))
          ctx.globalAlpha = 0.82
          ctx.fillStyle = dab.colour
          // A spindle: pointed at both ends, widest below the middle
          ctx.beginPath()
          ctx.moveTo(0, -dab.height / 2)
          ctx.quadraticCurveTo(dab.width, dab.height * 0.12, 0, dab.height / 2)
          ctx.quadraticCurveTo(-dab.width, dab.height * 0.12, 0, -dab.height / 2)
          ctx.fill()
          ctx.restore()
          continue
        }

        // A leaf-shaped touch: round at the foot, drawn up to a point
        ctx.fillStyle = dab.colour
        ctx.beginPath()
        ctx.moveTo(dab.x - half, dab.y)
        ctx.quadraticCurveTo(dab.x - half * 1.1 + bend * 0.4, dab.y - dab.height * 0.55, tipX, tipY)
        ctx.quadraticCurveTo(dab.x + half * 1.1 + bend * 0.4, dab.y - dab.height * 0.55, dab.x + half, dab.y)
        ctx.quadraticCurveTo(dab.x, dab.y + half, dab.x - half, dab.y)
        ctx.fill()
      }
    }

    const loop = (now: number) => {
      paint(now)
      frame = visible && !still ? requestAnimationFrame(loop) : 0
    }

    const start = () => {
      if (!frame && visible && !still) frame = requestAnimationFrame(loop)
    }

    // Only animate while the field is on screen
    new IntersectionObserver(entries => {
      visible = entries[0].isIntersecting
      start()
    }).observe(canvas)

    addEventListener('pointermove', event => {
      const box = canvas.getBoundingClientRect()
      pointerX = event.clientX - box.left
      pointerY = event.clientY - box.top
    })
    document.addEventListener('pointerleave', () => (pointerX = pointerY = -1e4))
    addEventListener('resize', resize)

    // Repaint in the other palette when the theme changes
    new MutationObserver(() => {
      plant()
      if (!frame) paint(performance.now())
    }).observe(root, { attributes: true, attributeFilter: ['class'] })

    resize()
  }
</script>
