---
// Illustrative chart for the new grad post: share of shipped code written by
// hand over the first 24 months, by the year a new grad started. Not measured.
const W = 640
const H = 340
const left = 76
const right = 524
const top = 20
const bottom = 280

const x = (m: number) => left + (m / 24) * (right - left)
const y = (p: number) => bottom - (p / 100) * (bottom - top)

type Cohort = {
  id: string
  label: string
  tone: string
  points: [number, number][]
  projectedFrom?: number
}

const cohorts: Cohort[] = [
  { id: 'c2018', label: '2018 grad', tone: 'c1', points: [[0, 97], [6, 96], [12, 95], [18, 94], [24, 93]] },
  { id: 'c2022', label: '2022 grad', tone: 'c2', points: [[0, 90], [6, 84], [12, 74], [18, 60], [24, 48]] },
  { id: 'c2024', label: '2024 grad', tone: 'c3', points: [[0, 62], [6, 46], [12, 30], [18, 20], [24, 14]] },
  {
    id: 'c2026',
    label: '2026 grad',
    tone: 'c4',
    points: [[0, 15], [3, 11], [6, 8], [12, 5], [18, 4], [24, 3]],
    projectedFrom: 3
  }
]

const path = (pts: [number, number][]) =>
  pts.map(([m, p], i) => `${i ? 'L' : 'M'}${x(m).toFixed(1)},${y(p).toFixed(1)}`).join(' ')

const series = cohorts.map((c) => {
  const cut = c.projectedFrom ?? 24
  const solid = c.points.filter(([m]) => m <= cut)
  const projected = c.points.filter(([m]) => m >= cut)
  const last = c.points[c.points.length - 1]
  return {
    ...c,
    solid: path(solid),
    projected: projected.length > 1 ? path(projected) : null,
    labelY: y(last[1]) + 4
  }
})

const yTicks = [0, 25, 50, 75, 100]
const xTicks = [0, 6, 12, 18, 24]
const data = JSON.stringify(cohorts.map(({ id, label, tone, points, projectedFrom }) => ({ id, label, tone, points, projectedFrom })))
---

<figure class="hw-chart" data-chart={data} data-geom={JSON.stringify({ left, right, top, bottom, W, H })}>
  <div class="frame">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="hw-title hw-desc">
      <title id="hw-title">Share of shipped code written by hand, by new grad cohort (illustrative)</title>
      <desc id="hw-desc">
        Four illustrative curves over the first 24 months of a new grad's career. The 2018 cohort stays near 95
        percent hand-written. The 2022 cohort starts near 90 percent and falls to about half. The 2024 cohort
        starts near 60 percent and falls to about 15. The 2026 cohort starts around 15 percent and is projected to
        fall below 5.
      </desc>

      {yTicks.map((p) => (
        <g>
          <line class="grid" x1={left} y1={y(p)} x2={right} y2={y(p)} />
          <text class="tick" x={left - 10} y={y(p) + 4} text-anchor="end">{p}%</text>
        </g>
      ))}
      {xTicks.map((m) => (
        <text class="tick" x={x(m)} y={bottom + 20} text-anchor="middle">{m}</text>
      ))}
      <text class="axis-title" x={(left + right) / 2} y={bottom + 44} text-anchor="middle">
        months since starting the first job
      </text>
      <text
        class="axis-title"
        transform={`translate(18 ${(top + bottom) / 2}) rotate(-90)`}
        text-anchor="middle"
      >
        share of shipped code written by hand
      </text>

      {series.map((s, i) => (
        <g class={`series ${s.tone}`} style={`--i: ${i}`} data-id={s.id}>
          <path class="line solid" d={s.solid} pathLength="1" />
          {s.projected && <path class="line projected" d={s.projected} />}
          <text class="label" x={right + 8} y={s.labelY}>{s.label}</text>
          <circle class="dot" r="4" cx="0" cy="0" />
        </g>
      ))}

      <line class="cursor" x1="0" y1={top} x2="0" y2={bottom} />
      <rect class="hit" x={left} y={top} width={right - left} height={bottom - top} />
    </svg>
    <div class="readout" aria-hidden="true"></div>
  </div>
</figure>

<style>
  .hw-chart {
    margin: 2em 0;
  }

  .frame {
    position: relative;
  }

  .hw-chart svg {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border-radius: 0;
    overflow: visible;
    touch-action: pan-y;
  }


  .grid {
    stroke: var(--border);
    stroke-width: 1;
  }

  .tick,
  .axis-title {
    fill: var(--muted-foreground);
    font-family: var(--font-sans);
    font-size: 12px;
  }

  .axis-title {
    fill: var(--faint-foreground);
  }

  .line {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
    transition: stroke-width 0.2s ease, opacity 0.2s ease;
  }

  .projected {
    stroke-dasharray: 4 5;
  }

  .label {
    font-family: var(--font-sans);
    font-size: 12.5px;
    transition: opacity 0.2s ease;
  }

  .c1 { --tone: var(--faint-foreground); }
  .c2 { --tone: var(--muted-foreground); }
  .c3 { --tone: var(--foreground); }
  .c4 { --tone: var(--accent); }

  .series .line { stroke: var(--tone); }
  .series .label,
  .series .dot { fill: var(--tone); }

  .dot {
    stroke: var(--background);
    stroke-width: 2;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .cursor {
    stroke: var(--faint-foreground);
    stroke-width: 1;
    stroke-dasharray: 2 3;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .hit {
    fill: transparent;
    cursor: crosshair;
  }

  .readout {
    position: absolute;
    top: 0;
    left: 0;
    min-width: 9.5rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: var(--background);
    font-size: 0.75rem;
    line-height: 1.55;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .readout :global(.head) {
    color: var(--muted-foreground);
    margin-bottom: 0.2rem;
  }

  .readout :global(.row) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .readout :global(.row b) {
    margin-left: auto;
    font-weight: 600;
  }

  .readout :global(.sw) {
    width: 0.6rem;
    height: 2px;
    background: var(--tone);
  }

  .readout :global(.c1) { --tone: var(--faint-foreground); }
  .readout :global(.c2) { --tone: var(--muted-foreground); }
  .readout :global(.c3) { --tone: var(--foreground); }
  .readout :global(.c4) { --tone: var(--accent); }

  .hw-chart.active .cursor,
  .hw-chart.active .dot,
  .hw-chart.active .readout {
    opacity: 1;
  }

  .hw-chart.active .readout {
    transform: none;
  }

  /* Focus one cohort when hovering its label */
  .hw-chart.focus .series:not(.focused) .line,
  .hw-chart.focus .series:not(.focused) .label {
    opacity: 0.25;
  }

  .hw-chart.focus .series.focused .line {
    stroke-width: 3;
  }

  /* Draw-in: only when JS has opted in, so the static chart is the fallback */
  .hw-chart[data-anim='pending'] .solid {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }

  .hw-chart[data-anim='pending'] .projected,
  .hw-chart[data-anim='pending'] .label {
    opacity: 0;
  }

  .hw-chart[data-anim='run'] .solid {
    stroke-dasharray: 1;
    animation: hw-draw 1.4s cubic-bezier(0.65, 0, 0.35, 1) both;
    animation-delay: calc(var(--i) * 0.45s);
  }

  .hw-chart[data-anim='run'] .label {
    animation: hw-fade 0.5s ease both;
    animation-delay: calc(var(--i) * 0.45s + 1.1s);
  }

  /* The 2026 line only has a few months of solid data, so its guess fades in after */
  .hw-chart[data-anim='run'] .projected {
    animation: hw-fade 0.9s ease both;
    animation-delay: calc(var(--i) * 0.45s + 0.6s);
  }

  /* Opacity flips on at the first frame so the round cap doesn't show as a dot while waiting */
  @keyframes hw-draw {
    0% { stroke-dashoffset: 1; opacity: 0; }
    1% { opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 1; }
  }

  @keyframes hw-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hw-chart[data-anim] .solid,
    .hw-chart[data-anim] .projected,
    .hw-chart[data-anim] .label {
      animation: none !important;
      stroke-dashoffset: 0 !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  type Cohort = {
    id: string
    label: string
    tone: string
    points: [number, number][]
    projectedFrom?: number
  }

  const valueAt = (pts: [number, number][], m: number) => {
    for (let i = 1; i < pts.length; i++) {
      const [m0, p0] = pts[i - 1]
      const [m1, p1] = pts[i]
      if (m <= m1) return p0 + ((p1 - p0) * (m - m0)) / (m1 - m0)
    }
    return pts[pts.length - 1][1]
  }

  for (const fig of document.querySelectorAll<HTMLElement>('.hw-chart')) {
    const cohorts: Cohort[] = JSON.parse(fig.dataset.chart!)
    const g = JSON.parse(fig.dataset.geom!)
    const svg = fig.querySelector('svg')!
    const hit = fig.querySelector<SVGRectElement>('.hit')!
    const cursor = fig.querySelector<SVGLineElement>('.cursor')!
    const readout = fig.querySelector<HTMLElement>('.readout')!
    const frame = fig.querySelector<HTMLElement>('.frame')!
    const x = (m: number) => g.left + (m / 24) * (g.right - g.left)
    const y = (p: number) => g.bottom - (p / 100) * (g.bottom - g.top)

    // Draw the lines in when the chart scrolls into view
    if ('IntersectionObserver' in window) {
      fig.dataset.anim = 'pending'
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            fig.dataset.anim = 'run'
            io.disconnect()
          }
        },
        { threshold: 0.4 }
      )
      io.observe(fig)
    }

    const show = (clientX: number) => {
      const pt = svg.createSVGPoint()
      pt.x = clientX
      pt.y = 0
      const local = pt.matrixTransform(svg.getScreenCTM()!.inverse())
      const m = Math.max(0, Math.min(24, ((local.x - g.left) / (g.right - g.left)) * 24))
      const month = Math.round(m)
      const cx = x(month)
      cursor.setAttribute('x1', String(cx))
      cursor.setAttribute('x2', String(cx))

      const rows = cohorts.map((c) => {
        const v = valueAt(c.points, month)
        const dot = fig.querySelector<SVGCircleElement>(`.series[data-id="${c.id}"] .dot`)!
        dot.setAttribute('cx', String(cx))
        dot.setAttribute('cy', String(y(v)))
        const guess = c.projectedFrom !== undefined && month > c.projectedFrom ? ' (guess)' : ''
        return `<div class="row ${c.tone}"><span class="sw"></span>${c.label}${guess}<b>${Math.round(v)}%</b></div>`
      })
      readout.innerHTML = `<div class="head">Month ${month}</div>${rows.join('')}`

      // Keep the readout inside the frame, on the side away from the cursor
      const scale = frame.clientWidth / g.W
      const px = cx * scale
      const w = readout.offsetWidth
      const leftPos = px + 14 + w > frame.clientWidth ? px - 14 - w : px + 14
      readout.style.left = `${Math.max(0, leftPos)}px`
      readout.style.top = `${g.top * scale}px`
      fig.classList.add('active')
    }

    const hide = () => fig.classList.remove('active')

    hit.addEventListener('pointermove', (e) => show(e.clientX))
    hit.addEventListener('pointerdown', (e) => show(e.clientX))
    hit.addEventListener('pointerleave', hide)

    for (const s of fig.querySelectorAll<SVGGElement>('.series')) {
      const label = s.querySelector('.label')!
      label.addEventListener('pointerenter', () => {
        fig.classList.add('focus')
        s.classList.add('focused')
      })
      label.addEventListener('pointerleave', () => {
        fig.classList.remove('focus')
        s.classList.remove('focused')
      })
    }
  }
</script>
