---
interface Props {
  title: string
  note?: string
}

const { title, note } = Astro.props
---

<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b pb-2.5">
  <h2 class="text-[1.0625rem] font-semibold">{title}</h2>
  {note && <p class="text-sm text-muted-foreground">{note}</p>}
</div>
