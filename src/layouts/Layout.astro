---
import '../styles/global.css'
import '../styles/mdx.css'
import 'temml/dist/Temml-Local.css'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Sam Jin',
  description = 'Software engineer working on AI tooling, agents, and scalable backend systems.'
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      const theme =
        localStorage.getItem('theme') ??
        (window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light')
      document.documentElement.classList.toggle('dark', theme === 'dark')
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-0M79FQ0DWJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        dataLayer.push(arguments)
      }
      gtag('js', new Date())
      gtag('config', 'G-0M79FQ0DWJ')
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <div class="mx-auto w-full max-w-2xl flex-1 flex flex-col px-6">
      <Header pathname={Astro.url.pathname} />
      <main class="flex-1 pb-16">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
