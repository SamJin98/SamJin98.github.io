---
import '../styles/global.css'
import '../styles/mdx.css'
import 'temml/dist/Temml-Local.css'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Sam Jin',
  description = 'Software engineer working on AI tooling, agents, and scalable backend systems.'
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      const theme =
        localStorage.getItem('theme') ??
        (window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light')
      document.documentElement.classList.toggle('dark', theme === 'dark')
    </script>
    <script is:inline>
      // Page transitions: the title you click grows into the page heading
      // (and shrinks back). Only that pair is named, and only for the swap,
      // so the theme toggle's transition is left alone.
      ;(() => {
        if (!('onpagereveal' in window)) return
        const path = url => new URL(url).pathname.replace(/(.)\/$/, '$1')
        let named = null
        const clear = () => {
          if (named) named.style.viewTransitionName = ''
          named = null
        }
        // Same pick on both pages: the page being opened, else the one being left
        const find = p => document.querySelector(`[data-vt="${CSS.escape(p)}"]`)
        const name = el => {
          el.style.viewTransitionName = 'page-title'
          named = el
        }
        const pair = (from, to) => {
          clear()
          let el = find(path(to))
          if (el) return name(el), 'grow'
          el = find(path(from))
          if (el) return name(el), 'shrink'
        }
        // Where the swap goes is handed to the next page through
        // sessionStorage: on a back/forward restored from the page cache,
        // navigation.activation can still describe an older visit.
        let lastClicked = null
        addEventListener('click', e => {
          const a = e.target.closest?.('a[href]')
          if (a) lastClicked = a.href
        })
        addEventListener('pageswap', e => {
          sessionStorage.removeItem('vt')
          clear()
          const to = e.activation?.entry?.url ?? lastClicked
          if (!e.viewTransition || !to) return
          pair(location.href, to)
          sessionStorage.setItem('vt', JSON.stringify([location.href, to]))
        })
        addEventListener('pagereveal', e => {
          clear()
          const saved = sessionStorage.getItem('vt')
          sessionStorage.removeItem('vt')
          if (!e.viewTransition || !saved) return
          const [from, to] = JSON.parse(saved)
          if (path(to) !== path(location.href)) return
          const root = document.documentElement
          const move = pair(from, location.href)
          if (move) root.dataset.move = move
          e.viewTransition.finished.finally(() => {
            clear()
            delete root.dataset.move
          })
        })
      })()
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-0M79FQ0DWJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        dataLayer.push(arguments)
      }
      gtag('js', new Date())
      gtag('config', 'G-0M79FQ0DWJ')
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <div class="mx-auto w-full max-w-2xl flex-1 flex flex-col px-6">
      <Header pathname={Astro.url.pathname} />
      <main class="flex-1 pb-16">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
